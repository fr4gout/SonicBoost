{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SonicBoost",
  "version": "1.0.0",
  "identifier": "dev.synclab.sonicboost",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SonicBoost",
        "width": 400,
        "height": 740,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "publisher": "SYNC Lab",
    "shortDescription": "Sound booster, equalizer, pitch and visualizer",
    "longDescription": "SonicBoost boosts system volume up to 600%, adds a 10-band equalizer, real-time pitch shifting, a Now Playing panel and animated visualizers.",
    "category": "Music",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}